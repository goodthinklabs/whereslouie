# Copy this file to .env and fill in your values
# Do NOT commit .env to git

# ── Tracki credentials ────────────────────────────────────────────────────────
TRACKI_USER=your@email.com
TRACKI_PASS=yourpassword

# From the Tracki developer portal (app.trackimo.com → Developer → Add new app)
TRACKI_CLIENT_ID=paste-your-client-id-here
TRACKI_CLIENT_SECRET=paste-your-client-secret-here

# Must match what you registered in the developer portal
TRACKI_REDIRECT_URI=https://goodthinklabs.github.io/whereslouie

# Optional: pin to a specific device ID (leave blank to auto-detect first device)
TRACKI_DEVICE_ID=

# ── Google Apps Script ────────────────────────────────────────────────────────
# The Google Apps Script Web App URL — you get this after deploying Code.gs
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID_HERE/exec

# A secret key shared between this script and Apps Script to prevent unauthorized writes
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
BRIDGE_SECRET=change_me_to_a_long_random_string

# ── Polling interval ──────────────────────────────────────────────────────────
# How often to ask Tracki for a new position (seconds). 300 = every 5 minutes.
POLL_INTERVAL_SECS=300
